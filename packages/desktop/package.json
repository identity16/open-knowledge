{
  "name": "@inkeep/open-knowledge-desktop",
  "productName": "OpenKnowledge",
  "version": "0.0.0-unknown",
  "license": "GPL-3.0-or-later",
  "homepage": "https://openknowledge.ai",
  "author": {
    "name": "Inkeep",
    "email": "support@inkeep.com"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev:electron --filter=@inkeep/open-knowledge-desktop",
    "dev:electron": "node ../app/scripts/compile-i18n-catalogs.ts && electron-vite dev --watch",
    "build:desktop": "node ../core/scripts/build-output.mjs verify && node ../app/scripts/compile-i18n-catalogs.ts && electron-vite build",
    "build:dir": "pnpm run build:desktop && node scripts/run-electron-builder.mjs --dir --publish never",
    "build:mac": "pnpm run build:desktop && node scripts/prepare-universal.mjs && node scripts/stage-parcel-watcher.mjs && node scripts/run-electron-builder.mjs --mac --publish never",
    "build:mac:unsigned": "pnpm run build:desktop && node scripts/prepare-universal.mjs && node scripts/stage-parcel-watcher.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/run-electron-builder.mjs --mac --publish never -c.mac.identity=null",
    "prepare:universal": "node scripts/prepare-universal.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "smoke:mock-update": "OK_UPDATER_FORCE_DEV=1 node scripts/smoke-mock-update.mjs",
    "instances": "node scripts/launch-instances.mjs",
    "lint": "biome check . && oxlint --max-warnings 0 .",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inkeep/open-knowledge": "workspace:*",
    "@inkeep/open-knowledge-core": "workspace:*",
    "@inkeep/open-knowledge-native-config": "workspace:*",
    "@inkeep/open-knowledge-server": "workspace:*",
    "@lingui/core": "^6.12.0",
    "@lingui/message-utils": "^6.12.0",
    "@napi-rs/keyring": "2.1.2",
    "@opentelemetry/api": "^1.9.0",
    "electron-updater": "6.8.4",
    "pino": "^10.3.1",
    "semver": "^7.7.4",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@electron/notarize": "^3.1.1",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.7.0",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^6.3.0",
    "culori": "^4.0.2",
    "electron": "44.9.1",
    "electron-builder": "^26.16.1",
    "electron-vite": "^6.0.0",
    "oxc-transform-react": "0.156.0",
    "ts-morph": "^28.0.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vite": "^8.0.0"
  }
}
